TELEPHONY_PROVIDER=kcell

KCELL_BASE_URL=https://corpsol.vpbx.kcell.kz/crmapi/v1
KCELL_API_KEY=
KCELL_TZ=Asia/Almaty
KCELL_COUNT_DIRECTIONS=out
KCELL_OPERATORS_YML=operators.yml

TZ=Asia/Almaty
CHECK_EVERY_SECONDS=300
THRESHOLDS_MINUTES=15,30,60

# ПН-ПТ
WORK_START=11:00
WORK_END=20:00
# СБ — отдельный график (ВС всегда выходной)
SAT_WORK_START=11:00
SAT_WORK_END=20:00

LUNCH_START=13:00
LUNCH_END=14:00

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# тема (topic) в супергруппе с включёнными Forum Topics - если пусто, идёт в General
TELEGRAM_THREAD_ID=
# алерты неактивности можно направить в отдельный чат/тему; по умолчанию = общий чат/тема
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_THREAD_ID=

# путь к SQLite со state (алерты/WA/absent); на Railway вынеси на
# подключённый volume, например /data/state.db
STATE_DB_PATH=state.db
